# Every variable GigBid reads. Copy to .env and fill in; never commit .env.
# Names only here: CI fails if a value that looks like a real secret appears in this file.

# ---- environment
GIGBID_ENV=dev                         # dev | production (production refuses to start without the secrets below)
GIGBID_RELEASE=

# ---- models (agent/config.yaml routes each node; see "models.profiles")
GIGBID_MODEL_PROFILE=open              # open (Groq) | open_local (Ollama) | paid (Anthropic)
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=                       # e.g. http://ollama:11434 in docker compose
GIGBID_OFFLINE=0                       # 1 = never call a model (rule paths only)

# ---- marketplace
MARKETPLACE_MODE=gigsim                # gigsim | upwork_live (per user in the app; this is the default)
GIGSIM_BASE_URL=http://localhost:8100
GIGSIM_TOKEN=                          # stdio / single-user runs only
GIGSIM_ADMIN_TOKEN=
GIGSIM_ERROR_RATE=0.02
GIGSIM_SPEED=60
GIGSIM_POLICY_VERSION=1
GIGSIM_STATE_FILE=
GIGBID_EMBED_GIGSIM=0                  # 1 = serve GigSim inside the API at /gigsim (single-container deploys)

# ---- Upwork live mode (official Upwork MCP server + OAuth)
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
UPWORK_REDIRECT_URI=                   # https://<your-host>/api/auth/upwork/callback

# ---- GitHub MCP (portfolio ingestion from a GitHub account)
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
GITHUB_TOKEN=                          # fine-grained, read-only: contents + metadata

# ---- storage
DATABASE_URL=                          # postgresql://gigbid:<password>@postgres:5432/gigbid (empty = local SQLite files)
APP_DATABASE_URL=                      # optional override for the app tables
MEMORY_DATABASE_URL=                   # optional override for the long-term memory store
REDIS_URL=                             # redis://redis:6379/0 (empty = run graphs inside the API process)
QDRANT_URL=                            # http://qdrant:6333 (empty = in-process vector index)
QDRANT_API_KEY=
GIGBID_MODEL_CACHE=                    # where fastembed models are cached (default data/models)

# ---- security
JWT_SECRET=                            # long random string (session cookies)
TOKEN_ENCRYPTION_KEY=                  # Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_CALLER_SECRET=                     # signs per-user tokens the API/worker send to the MCP servers
MCP_ALLOWED_HOSTS=                     # e.g. mcp-marketplace:*,mcp-portfolio:*,mcp-workspace:*
GIGBID_ALLOW_SIGNUP=1                  # 0 on a public demo after the reviewer account exists
REVIEWER_EMAIL=                        # used once by `python -m apps.api.seed_reviewer`; never committed
REVIEWER_PASSWORD=

# ---- MCP topology
MCP_MODE=inprocess                     # inprocess | http (docker compose: separate MCP services)
MCP_MARKETPLACE_URL=                   # http://mcp-marketplace:8201/mcp
MCP_PORTFOLIO_URL=                     # http://mcp-portfolio:8202/mcp
MCP_WORKSPACE_URL=                     # http://mcp-workspace:8203/mcp
MARKETPLACE_MCP_TOKENS=                # static tokens for desktop hosts, JSON {"<token>": {...caller}}
PORTFOLIO_MCP_TOKENS=
WORKSPACE_MCP_TOKENS=
PORTFOLIO_PERSONA=ai_ml                # stdio runs of the Portfolio server
PORTFOLIO_DIR=
WORKSPACE_DIR=

# ---- worker
WORKER_MAX_JOBS=8
GIGBID_RUNS_PER_USER=2
GIGBID_SYNC=1                          # in-process sync loop when there is no worker
GIGBID_SYNC_INTERVAL_S=15

# ---- tracing (Langfuse cloud or self-hosted; empty = tracing off)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
TRACE_URL_TEMPLATE=                    # optional: https://.../trace/{trace_id}
