{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "gigsim",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "gigsim.app:app", "--port", "8100"],
      "port": 8100
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python",
      "runtimeArgs": ["-m", "uvicorn", "apps.api.main:app", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "apps/web", "run", "dev"],
      "port": 5173
    }
  ]
}
