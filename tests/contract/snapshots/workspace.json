{
  "create_email_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Save an email DRAFT for the freelancer to review and send themselves. Never sends.",
    "input": {
      "properties": {
        "body": {
          "maxLength": 8000,
          "minLength": 1,
          "title": "Body",
          "type": "string"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9:_\\-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "subject": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "maxLength": 200,
          "minLength": 3,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "to",
        "subject",
        "body",
        "idempotency_key"
      ],
      "title": "create_email_draftArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "body": {
          "title": "Body",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "subject": {
          "title": "Subject",
          "type": "string"
        },
        "to": {
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "to",
        "subject",
        "body",
        "status"
      ],
      "title": "EmailDraft",
      "type": "object"
    }
  },
  "create_interview_hold": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": false
    },
    "description": "Put a TENTATIVE hold on the calendar for a proposed interview. Does not invite anyone.",
    "input": {
      "properties": {
        "duration_min": {
          "maximum": 180,
          "minimum": 15,
          "title": "Duration Min",
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9:_\\-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "start": {
          "description": "ISO datetime with offset",
          "title": "Start",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "maxLength": 64,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "title": {
          "maxLength": 120,
          "minLength": 3,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "start",
        "duration_min",
        "title",
        "idempotency_key"
      ],
      "title": "create_interview_holdArguments",
      "type": "object"
    },
    "output": {
      "properties": {
        "end": {
          "title": "End",
          "type": "string"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "start": {
          "title": "Start",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "thread_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thread Id"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "start",
        "end",
        "status"
      ],
      "title": "Hold",
      "type": "object"
    }
  },
  "free_slots": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Free interview slots inside working hours, avoiding existing events and holds.",
    "input": {
      "properties": {
        "days": {
          "default": 5,
          "maximum": 14,
          "minimum": 1,
          "title": "Days",
          "type": "integer"
        },
        "duration_min": {
          "default": 30,
          "maximum": 180,
          "minimum": 15,
          "title": "Duration Min",
          "type": "integer"
        },
        "from_date": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO date to start from; default tomorrow",
          "title": "From Date"
        },
        "max_slots": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "title": "Max Slots",
          "type": "integer"
        }
      },
      "title": "free_slotsArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Slot": {
          "properties": {
            "end": {
              "title": "End",
              "type": "string"
            },
            "start": {
              "title": "Start",
              "type": "string"
            },
            "timezone": {
              "title": "Timezone",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end",
            "timezone"
          ],
          "title": "Slot",
          "type": "object"
        }
      },
      "properties": {
        "slots": {
          "items": {
            "$ref": "#/$defs/Slot"
          },
          "title": "Slots",
          "type": "array"
        },
        "timezone": {
          "title": "Timezone",
          "type": "string"
        }
      },
      "required": [
        "timezone",
        "slots"
      ],
      "title": "SlotList",
      "type": "object"
    }
  },
  "list_holds": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Tentative interview holds currently on the calendar.",
