      "type": "object"
    },
    "output": {
      "$defs": {
        "Hold": {
          "properties": {
            "end": {
              "title": "End",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "start": {
              "title": "Start",
              "type": "string"
            },
            "status": {
              "title": "Status",
              "type": "string"
            },
            "thread_id": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Thread Id"
            },
            "title": {
              "title": "Title",
              "type": "string"
            }
          },
          "required": [
            "id",
            "title",
            "start",
            "end",
            "status"
          ],
          "title": "Hold",
          "type": "object"
        }
      },
      "properties": {
        "items": {
          "items": {
            "$ref": "#/$defs/Hold"
          },
          "title": "Items",
          "type": "array"
        }
      },
      "required": [
        "items"
      ],
      "title": "HoldList",
      "type": "object"
    }
  }
}
