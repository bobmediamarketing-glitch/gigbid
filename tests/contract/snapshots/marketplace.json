    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Search open jobs, newest first. Use for scouting saved searches.",
    "input": {
      "properties": {
