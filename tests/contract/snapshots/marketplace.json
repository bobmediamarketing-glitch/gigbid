{
  "create_proposal_draft": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Create a proposal DRAFT on the marketplace. Spends no Connects. Only call after the user approved the text.",
    "input": {
      "properties": {
        "bid_amount": {
          "description": "Total for fixed price, per hour for hourly",
          "exclusiveMinimum": 0,
          "maximum": 100000,
          "title": "Bid Amount",
          "type": "number"
        },
        "bid_type": {
          "enum": [
            "fixed",
            "hourly"
          ],
          "title": "Bid Type",
          "type": "string"
        },
        "cover_letter": {
          "maxLength": 5000,
          "minLength": 150,
          "title": "Cover Letter",
          "type": "string"
        },
        "dry_run": {
          "default": false,
          "title": "Dry Run",
          "type": "boolean"
        },
        "idempotency_key": {
          "description": "Unique per intended action; a retry with the same key never repeats it.",
          "maxLength": 128,
          "minLength": 8,
          "pattern": "^[A-Za-z0-9:_\\-]+$",
          "title": "Idempotency Key",
          "type": "string"
        },
        "job_id": {
          "description": "Marketplace job id",
          "maxLength": 64,
          "minLength": 1,
          "title": "Job Id",
          "type": "string"
        },
        "screening_answers": {
          "default": [],
          "items": {
            "maxLength": 1500,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Screening Answers",
          "type": "array"
        }
      },
      "required": [
        "job_id",
        "cover_letter",
        "bid_amount",
        "bid_type",
        "idempotency_key"
      ],
      "title": "create_proposal_draftArguments",
      "type": "object"
    },
    "output": {
      "$defs": {
        "Message": {
          "properties": {
            "at": {
              "title": "At",
              "type": "string"
            },
            "body": {
              "title": "Body",
              "type": "string"
            },
            "from": {
              "enum": [
                "client",
                "freelancer"
              ],
              "title": "From",
              "type": "string"
            },
            "id": {
              "title": "Id",
              "type": "string"
            }
          },
          "required": [
            "id",
            "from",
            "body",
            "at"
          ],
          "title": "Message",
          "type": "object"
        },
        "Proposal": {
          "properties": {
            "bid_amount": {
              "title": "Bid Amount",
              "type": "number"
            },
            "bid_type": {
              "enum": [
                "fixed",
                "hourly"
              ],
              "title": "Bid Type",
              "type": "string"
            },
            "connects_spent": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connects Spent"
            },
            "cover_letter": {
              "title": "Cover Letter",
              "type": "string"
            },
            "created_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Created At"
            },
            "id": {
              "title": "Id",
              "type": "string"
            },
            "idempotent_replay": {
              "default": false,
              "title": "Idempotent Replay",
              "type": "boolean"
            },
            "job_id": {
              "title": "Job Id",
              "type": "string"
            },
            "screening_answers": {
              "default": [],
              "items": {
                "type": "string"
              },
              "title": "Screening Answers",
              "type": "array"
            },
            "status": {
              "title": "Status",
              "type": "string"
            },
            "submitted_at": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Submitted At"
            }
          },
          "required": [
            "id",
            "job_id",
            "status",
            "cover_letter",
            "bid_amount",
            "bid_type"
          ],
          "title": "Proposal",
          "type": "object"
        },
        "WritePreview": {
          "description": "What a write would send and what it costs (dry_run). Shown on the approval screen.",
          "properties": {
            "action": {
              "enum": [
                "create_proposal_draft",
                "submit_proposal",
                "send_message"
              ],
              "title": "Action",
              "type": "string"
            },
            "connects_balance_after": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Connects Balance After"
            },
            "connects_cost": {
              "default": 0,
              "title": "Connects Cost",
              "type": "integer"
            },
            "payload": {
              "additionalProperties": true,
              "title": "Payload",
              "type": "object"
            },
            "target": {
              "title": "Target",
              "type": "string"
            }
          },
          "required": [
            "action",
            "payload",
            "target"
          ],
          "title": "WritePreview",
          "type": "object"
        }
      },
      "properties": {
        "dry_run": {
          "title": "Dry Run",
          "type": "boolean"
        },
        "message": {
          "anyOf": [
            {
              "$ref": "#/$defs/Message"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "preview": {
          "anyOf": [
            {
              "$ref": "#/$defs/WritePreview"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proposal": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proposal"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "dry_run"
      ],
      "title": "WriteResult",
      "type": "object"
    }
  },
